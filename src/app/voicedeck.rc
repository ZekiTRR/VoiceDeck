#include "resource.h"
#include <windows.h>

IDI_VOICEDECK ICON "../../assets/voicedeck.ico"

1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
    VALUE "CompanyName", "VoiceDeck"
    VALUE "FileDescription", "VoiceDeck voice changer and soundboard"
    VALUE "FileVersion", "2.0.0.0"
    VALUE "InternalName", "voicedeck"
    VALUE "OriginalFilename", "voicedeck.exe"
    VALUE "ProductName", "VoiceDeck"
    VALUE "ProductVersion", "2.0.0.0"
  END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
